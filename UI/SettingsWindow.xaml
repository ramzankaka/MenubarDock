<Window x:Class="MenubarDock.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MenubarDock Settings"
        Height="580" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="#18181A"
        Foreground="#E0E0E0">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A2E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#202024" Padding="20,15"
                BorderBrush="#30FFFFFF" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="MenubarDock" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text=" — macOS Top Menu Bar for Windows 11"
                           FontSize="13" Foreground="#888888" Margin="8,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" Margin="22,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- APPEARANCE -->
                <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold"
                           Foreground="#FFFFFF" Margin="0,0,0,10"/>

                <TextBlock Text="Theme Mode" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbTheme" SelectionChanged="OnSettingChanged" Margin="0,0,0,8">
                    <ComboBoxItem Content="Frosted Glass (Default)" Tag="FrostedGlass"/>
                    <ComboBoxItem Content="Dark Glass" Tag="DarkGlass"/>
                    <ComboBoxItem Content="Light Glass" Tag="LightGlass"/>
                    <ComboBoxItem Content="OLED Black" Tag="OLEDBlack"/>
                </ComboBox>

                <TextBlock Text="Menu Bar Height (px)" Foreground="#CCCCCC" Margin="0,8,0,2"/>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding ElementName=SliderHeight, Path=Value, StringFormat={}{0:F0} px}"
                               Width="50" DockPanel.Dock="Right" Foreground="#0078D4"/>
                    <Slider x:Name="SliderHeight" Minimum="24" Maximum="42" Value="30"
                            ValueChanged="OnSettingChanged"/>
                </DockPanel>

                <TextBlock Text="Transparency / Opacity" Foreground="#CCCCCC" Margin="0,4,0,2"/>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding ElementName=SliderOpacity, Path=Value, StringFormat={}{0:P0}}"
                               Width="50" DockPanel.Dock="Right" Foreground="#0078D4"/>
                    <Slider x:Name="SliderOpacity" Minimum="0.3" Maximum="1.0" Value="0.92"
                            ValueChanged="OnSettingChanged"/>
                </DockPanel>

                <Separator Background="#25FFFFFF" Margin="0,12"/>

                <!-- GENERAL -->
                <TextBlock Text="General" FontSize="15" FontWeight="SemiBold"
                           Foreground="#FFFFFF" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkStartup" Content="Start MenubarDock automatically with Windows"
                          Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                <CheckBox x:Name="ChkAutoHide" Content="Auto-hide Menu Bar when apps are in focus (reveal on touching top edge)"
                          Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

                <TextBlock Text="Global Hotkey: Ctrl + Alt + M — toggle show/hide"
                           Foreground="#888888" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>

                <Separator Background="#25FFFFFF" Margin="0,12"/>

                <!-- CLOCK -->
                <TextBlock Text="Clock and Date" FontSize="15" FontWeight="SemiBold"
                           Foreground="#FFFFFF" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkShowDate" Content="Show Date in Clock (e.g. Fri Sep 4)"
                          Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                <CheckBox x:Name="Chk24Hour" Content="Use 24-Hour Time Format"
                          Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                <CheckBox x:Name="ChkShowSeconds" Content="Show Seconds in Clock"
                          Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

                <Separator Background="#25FFFFFF" Margin="0,12"/>

                <!-- WIDGETS -->
                <TextBlock Text="Visible Widgets (Right Side)" FontSize="15" FontWeight="SemiBold"
                           Foreground="#FFFFFF" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkBattery" Content="Battery and Charge Widget"
                          Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                <CheckBox x:Name="ChkWifi" Content="Wi-Fi and Network Widget"
                          Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                <CheckBox x:Name="ChkBluetooth" Content="Bluetooth Widget"
                          Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                <CheckBox x:Name="ChkVolume" Content="Volume Widget"
                          Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                <CheckBox x:Name="ChkFocus" Content="Focus / Half-Moon Do Not Disturb Widget"
                          Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                <CheckBox x:Name="ChkSearch" Content="Spotlight Search Icon"
                          Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                <CheckBox x:Name="ChkControlCenter" Content="Control Center Icon"
                          Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#202024" Padding="15,10"
                BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Click="OnCloseClicked" Width="90"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
