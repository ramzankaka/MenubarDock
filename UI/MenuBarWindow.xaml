<Window x:Class="MenubarDock.UI.MenuBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="macOS Menu Bar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Height="30"
        Loaded="OnWindowLoaded">

    <Window.Resources>
        <Style x:Key="MenuBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="1,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#F2202024"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="Margin" Value="4,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="MenuBarSlideTransform" Y="0"/>
        </Grid.RenderTransform>

        <!-- Menu Bar Container with TaskbarDock Glass Styling -->
        <Border x:Name="MenuBarContainer"
                BorderBrush="#35FFFFFF"
                BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC222226" Offset="0.0"/>
                    <GradientStop Color="#EE161618" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Apple Logo + Active App + Menus -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">

                    <!-- Apple System Menu -->
                    <Button x:Name="BtnApple" Style="{StaticResource MenuBtnStyle}" Click="OnOpenMenuClick" ToolTip="System Menu">
                        <Path x:Name="PathApple" Data="M18.71,19.5c-0.83,1.24-1.71,2.45-3.05,2.47c-1.34,0.03-1.77-0.79-3.29-0.79c-1.53,0-2,0.77-3.27,0.82c-1.31,0.05-2.3-1.32-3.14-2.53C4.25,17 2.94,12.45 4.7,9.39c0.87-1.52 2.43-2.48 4.12-2.51c1.28,-0.02 2.5,0.87 3.29,0.87c0.78,0 2.26-1.07 3.81-0.91c0.65,0.03 2.47,0.26 3.64,1.98c-0.09,0.06-2.17,1.28-2.15,3.81c0.03,3.02 2.65,4.03 2.68,4.04c-0.03,0.07-0.42,1.44-1.38,2.83M15.97,6.88c0.66-0.8 1.11-1.92 0.99-3.04c-0.96,0.04-2.11,0.64-2.8,1.44c-0.6,0.69-1.13,1.83-0.99,2.92c1.07,0.08 2.16,-0.55 2.8,-1.32z"
                              Fill="#FFFFFF" Width="13" Height="15" Stretch="Uniform"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="About This PC" Click="OnAboutThisPcClick"/>
                                <MenuItem Header="System Settings..." Click="OnSystemSettingsClick"/>
                                <Separator/>
                                <MenuItem Header="Task Manager" Click="OnTaskManagerClick"/>
                                <MenuItem Header="Menu Bar Settings..." Click="OnMenuBarSettingsClick"/>
                                <Separator/>
                                <MenuItem Header="Lock Screen" Click="OnLockScreenClick"/>
                                <MenuItem Header="Sleep" Click="OnSleepClick"/>
                                <MenuItem Header="Restart..." Click="OnRestartClick"/>
                                <MenuItem Header="Shut Down..." Click="OnShutdownClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Active App Name Menu Button -->
                    <Button x:Name="BtnActiveApp" Style="{StaticResource MenuBtnStyle}" Click="OnOpenMenuClick" Margin="4,0,2,0">
                        <TextBlock x:Name="TxtActiveApp" Text="Finder" FontWeight="Bold"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ActiveAppContextMenu">
                                <MenuItem x:Name="MenuAboutApp" Header="About Finder" Click="OnAboutActiveAppClick"/>
                                <Separator/>
                                <MenuItem x:Name="MenuHideApp" Header="Hide Finder  (Win+Down)" Click="OnHideActiveAppClick"/>
                                <MenuItem x:Name="MenuHideOthers" Header="Hide Others  (Win+Home)" Click="OnHideOthersClick"/>
                                <MenuItem x:Name="MenuShowAll" Header="Show All" Click="OnShowAllClick"/>
                                <Separator/>
                                <MenuItem x:Name="MenuQuitApp" Header="Quit Finder  (Alt+F4)" Click="OnQuitActiveAppClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- File -->
                    <Button x:Name="BtnFile" Style="{StaticResource MenuBtnStyle}" Content="File" Click="OnOpenMenuClick">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="New File Explorer Window" Click="OnNewExplorerClick"/>
                                <MenuItem Header="New Terminal Window" Click="OnNewTerminalClick"/>
                                <MenuItem Header="New Notepad" Click="OnNewNotepadClick"/>
                                <Separator/>
                                <MenuItem Header="Close Window  (Alt+F4)" Click="OnCloseActiveWindowClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Edit -->
                    <Button x:Name="BtnEdit" Style="{StaticResource MenuBtnStyle}" Content="Edit" Click="OnOpenMenuClick">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Undo  (Ctrl+Z)" Click="OnUndoClick"/>
                                <MenuItem Header="Redo  (Ctrl+Y)" Click="OnRedoClick"/>
                                <Separator/>
                                <MenuItem Header="Cut  (Ctrl+X)" Click="OnCutClick"/>
                                <MenuItem Header="Copy  (Ctrl+C)" Click="OnCopyClick"/>
                                <MenuItem Header="Paste  (Ctrl+V)" Click="OnPasteClick"/>
                                <MenuItem Header="Select All  (Ctrl+A)" Click="OnSelectAllClick"/>
                                <Separator/>
                                <MenuItem Header="Clipboard History  (Win+V)" Click="OnClipboardClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- View -->
                    <Button x:Name="BtnView" Style="{StaticResource MenuBtnStyle}" Content="View" Click="OnOpenMenuClick">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Toggle Full Screen  (F11)" Click="OnFullscreenClick"/>
                                <MenuItem Header="Zoom In  (Ctrl++)" Click="OnZoomInClick"/>
                                <MenuItem Header="Zoom Out  (Ctrl+-)" Click="OnZoomOutClick"/>
                                <MenuItem Header="Actual Size  (Ctrl+0)" Click="OnZoomResetClick"/>
                                <Separator/>
                                <MenuItem Header="Task View  (Win+Tab)" Click="OnTaskViewClick"/>
                                <MenuItem Header="Show Desktop  (Win+D)" Click="OnShowDesktopClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Window -->
                    <Button x:Name="BtnWindow" Style="{StaticResource MenuBtnStyle}" Content="Window" Click="OnOpenMenuClick">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Minimize  (Win+Down)" Click="OnMinimizeClick"/>
                                <MenuItem Header="Maximize  (Win+Up)" Click="OnMaximizeClick"/>
                                <MenuItem Header="Snap Left  (Win+Left)" Click="OnSnapLeftClick"/>
                                <MenuItem Header="Snap Right  (Win+Right)" Click="OnSnapRightClick"/>
                                <Separator/>
                                <MenuItem Header="Close Window  (Alt+F4)" Click="OnCloseActiveWindowClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Help -->
                    <Button x:Name="BtnHelp" Style="{StaticResource MenuBtnStyle}" Content="Help" Click="OnOpenMenuClick">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="MenubarDock Settings..." Click="OnMenuBarSettingsClick"/>
                                <MenuItem Header="About This PC" Click="OnAboutThisPcClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <!-- RIGHT: Status Widgets with TaskbarDock White Glyph Styling -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">

                    <!-- Battery Widget -->
                    <Button x:Name="BtnBattery" Style="{StaticResource MenuBtnStyle}" Click="OnOpenMenuClick" ToolTip="Battery and Power">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="22" Height="12" Margin="0,0,3,0" VerticalAlignment="Center">
                                <Border x:Name="BorderBatteryOutline" BorderBrush="#FFFFFF" BorderThickness="1.2" CornerRadius="2"
                                        Width="19" Height="11" HorizontalAlignment="Left">
                                    <Rectangle x:Name="RectBatteryLevel" Fill="#00D26A"
                                               HorizontalAlignment="Left" Width="14" Height="7" Margin="1"/>
                                </Border>
                                <Rectangle x:Name="RectBatteryNub" Fill="#FFFFFF" Width="2" Height="4"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0"/>
                                <Path x:Name="PathChargingBolt"
                                      Data="M4,0 L0,5 L3,5 L2,9 L7,3 L4,3 Z"
                                      Fill="#FFE600" Width="7" Height="9" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="TxtBatteryPercent" Text="100%" FontSize="12"
                                       Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Battery and Power Settings..." Click="OnBatterySettingsClick"/>
                                <MenuItem Header="Battery Saver..." Click="OnBatterySaverClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Wi-Fi Widget -->
                    <Button x:Name="BtnWifi" Style="{StaticResource MenuBtnStyle}" Click="OnOpenMenuClick" ToolTip="Wi-Fi and Network">
                        <Path x:Name="PathWifi"
                              Data="M12,4C7.31,4 3.07,5.9 0,8.98L12,21L24,8.98C20.93,5.9 16.69,4 12,4M12,6C16.14,6 19.89,7.66 22.65,10.37L12,21L1.35,10.37C4.11,7.66 7.86,6 12,6Z"
                              Fill="#FFFFFF" Width="15" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Wi-Fi Settings..." Click="OnWifiSettingsClick"/>
                                <MenuItem Header="Network and Internet Settings..." Click="OnNetworkSettingsClick"/>
                                <Separator/>
                                <MenuItem Header="Airplane Mode..." Click="OnAirplaneModeClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Bluetooth Widget -->
                    <Button x:Name="BtnBluetooth" Style="{StaticResource MenuBtnStyle}" Click="OnOpenMenuClick" ToolTip="Bluetooth">
                        <Path x:Name="PathBluetooth"
                              Data="M14.88,16.29L13,18.17V14.41M13,5.83L14.88,7.71L13,9.59M17.71,7.71L12,2H11V9.58L6.41,5L5,6.41L10.59,12L5,17.58L6.41,19L11,14.41V22H12L17.71,16.29L13.41,12L17.71,7.71Z"
                              Fill="#FFFFFF" Width="13" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Bluetooth Settings..." Click="OnBluetoothSettingsClick"/>
                                <MenuItem Header="Add Bluetooth Device..." Click="OnBluetoothSettingsClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Volume Widget -->
                    <Button x:Name="BtnVolume" Style="{StaticResource MenuBtnStyle}" Click="OnOpenMenuClick"
                            PreviewMouseWheel="OnVolumeMouseWheel" ToolTip="Sound and Volume (Scroll to adjust)">
                        <Path x:Name="PathVolume"
                              Data="M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.84 14,18.7V20.77C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.76 16.5,12M3,9V15H7L12,20V4L7,9H3Z"
                              Fill="#FFFFFF" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Mute / Unmute" Click="OnVolumeMuteClick"/>
                                <MenuItem Header="Volume Up" Click="OnVolumeUpClick"/>
                                <MenuItem Header="Volume Down" Click="OnVolumeDownClick"/>
                                <Separator/>
                                <MenuItem Header="Sound Settings..." Click="OnSoundSettingsClick"/>
                                <MenuItem Header="Volume Mixer..." Click="OnVolumeMixerClick"/>
                                <Separator/>
                                <MenuItem Header="Open Quick Settings (Win+A)" Click="OnQuickSettingsClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Half-Moon Focus Widget -->
                    <Button x:Name="BtnFocus" Style="{StaticResource MenuBtnStyle}" Click="OnOpenMenuClick" ToolTip="Focus / Do Not Disturb">
                        <Path x:Name="PathFocus"
                              Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4V20Z"
                              Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Focus and Do Not Disturb Settings..." Click="OnFocusSettingsClick"/>
                                <MenuItem Header="Notification Settings..." Click="OnNotificationSettingsClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Spotlight Search -->
                    <Button x:Name="BtnSearch" Style="{StaticResource MenuBtnStyle}" Click="OnSearchClick" ToolTip="Windows Search (Win+S)">
                        <Path x:Name="PathSearch"
                              Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                              Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Control Center -->
                    <Button x:Name="BtnControlCenter" Style="{StaticResource MenuBtnStyle}" Click="OnQuickSettingsClick" ToolTip="Control Center (Win+A)">
                        <Path x:Name="PathControlCenter"
                              Data="M4,6H16V8H4V6M4,16H16V18H4V16M18,6H20V8H18V6M18,16H20V18H18V16M8,11H20V13H8V11M4,11H6V13H4V11Z"
                              Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Clock and Date -->
                    <Button x:Name="BtnClock" Style="{StaticResource MenuBtnStyle}" Click="OnClockClick" ToolTip="Notification Center (Win+N)">
                        <TextBlock x:Name="TxtClock" Text="Fri Sep 4  4:30 PM" FontSize="12.5"
                                   FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
